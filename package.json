{
  "name": "naval-combat-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc && vite build && tsc -p server/tsconfig.json",
    "build:client": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "lint:fix": "eslint . --fix",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') try { require('child_process').execSync('pnpm exec husky', { stdio: 'inherit' }); } catch {}\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3"
  }
}
